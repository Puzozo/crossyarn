DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
# Where admin-uploaded images are stored (outside public/). Default: media-uploads
MEDIA_UPLOAD_DIR="media-uploads"

# Bunny Stream (protected paid video). Without these the protected-video block
# renders an "unavailable" placeholder instead of an iframe — nothing crashes.
# BUNNY_STREAM_LIBRARY_ID: numeric Stream library id from the Bunny dashboard.
# BUNNY_STREAM_TOKEN_KEY: the library's "Token Authentication Key" (secret) — never commit a real value.
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_TOKEN_KEY=""
